+
+// OATHBOUND calendar (patches/skymp/client-oathbound-calendar.patch).
+//
+// - Year: 4E 199 in real year 2026, one more each real year.
+// - Month and day: the real (UTC) date, January = Morning Star (0).
+// - Hour: one in-game day lasts 12 real hours, so the day/night cycle runs
+//   twice per real day (game midnight at 00:00 and 12:00 UTC, shifted by the
+//   client's hoursOffset setting). The date still changes once per real day.
+export const OATHBOUND_TIMESCALE = 2;
+const OATHBOUND_YEAR_BASE_REAL = 2026;
+const OATHBOUND_YEAR_BASE_GAME = 199;
+
+export function oathboundCalendar(nowMs: number, hoursOffset: number) {
+    const d = new Date(nowMs + hoursOffset * 60 * 60 * 1000);
+    const realHours = d.getUTCHours() + d.getUTCMinutes() / 60 + d.getUTCSeconds() / 3600 + d.getUTCMilliseconds() / 3600000;
+    const newGameHourValue = (realHours % 12) * 2;
+    const month = d.getUTCMonth();
+    // Sun's Dawn has 28 days: a real 29 February stays on the 28th.
+    const day = month === 1 ? Math.min(d.getUTCDate(), 28) : d.getUTCDate();
+    const year = d.getUTCFullYear() - OATHBOUND_YEAR_BASE_REAL + OATHBOUND_YEAR_BASE_GAME;
+    return { newGameHourValue, date: { day, month, year } };
+}
