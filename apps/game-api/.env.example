# Port the launcher calls (VITE_API_PORT in the launcher's .env).
GAME_API_PORT=7758
# 0.0.0.0 because players connect from outside. Use a firewall to restrict it.
GAME_API_BIND_HOST=0.0.0.0

# Slot capacity. Above this, players go into the queue.
QUEUE_CAPACITY=40

# Lifetime of the game session stored in `game_sessions` (12h). It must cover
# a whole session with room to reconnect after a crash — the game server
# queries the master API on every connection.
GAME_SESSION_TTL_SECONDS=43200

# Path to the parity manifest generated by scripts/generate-mods-manifest.js.
MODS_MANIFEST_PATH=./mods.json

# Same secret as apps/web and apps/bot-discord — protects /internal/*.
INTERNAL_API_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=skymp_rp
