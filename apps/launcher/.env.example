# Game server IP (where skse64_loader will connect)
VITE_SERVER_IP=127.0.0.1
# Game server port. MUST match "port" in
# skymp/config/server-settings.*.json — this used to say 7757 and there 7777, so
# the client tried to connect to a port where nobody was listening.
# Careful when changing it: SkyMP uses (port + 1) for the UI when the port is
# non-default, so 7757 would put the UI on 7758 and collide with VITE_API_PORT below.
VITE_SERVER_PORT=7777
# Game API port (apps/game-api): mods.json and the queue
VITE_API_PORT=7758

# Web panel URL (apps/web). The launcher uses it to complete the Discord login.
VITE_PANEL_URL=http://127.0.0.1:3001

# Discord OAuth2
# There is NO VITE_DISCORD_CLIENT_SECRET here: everything VITE_* is embedded in
# the installer and can be extracted by any player. The client secret lives only
# in apps/web/.env, which exchanges the code for a token.
VITE_DISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE
VITE_DISCORD_REDIRECT_URI=http://localhost:19847/callback

# GitHub distribution repository (e.g. tangoplaybr/skymp-dist)
VITE_GITHUB_DIST_REPO=your-user/your-dist-repo
