PANEL_PORT=3001
# Public URL of the panel. In production replace it with the real domain — it
# sets the origin accepted by CORS and the fallback for the Discord callback.
# Accepts a comma-separated list (e.g. apex + www).
PANEL_PUBLIC_URL=http://localhost:3001

# `production` turns on the `secure` session cookie. The proxy stays explicit.
NODE_ENV=development

# Turn on behind a reverse proxy (nginx, Cloudflare, Traefik). Without it Express
# sees the proxy's IP instead of the player's IP, and the rate limit starts
# counting the whole world as a single visitor — the limiter keeps "working" and
# protects nothing. Turn it on explicitly only when there is a trusted proxy.
TRUST_PROXY=false

# Allowlist of redirect_uri values accepted by POST /api/launcher/oauth/exchange —
# the route that trades the Discord `code` for the profile (the client secret
# lives only here, never in the launcher; see finding 2.2 of QA_REPORT). The
# default covers the launcher's local callback server (127.0.0.1:19847, see
# apps/launcher/electron/main.ts); only change it if that port changes.
LAUNCHER_REDIRECT_URIS=http://localhost:19847/callback,http://127.0.0.1:19847/callback

# Rotation of launcher crash reports. Without a limit the directory grows
# forever: each report carries up to 64 KB of log per crash.
CRASH_REPORT_MAX_FILES=500
CRASH_REPORT_MAX_AGE_DAYS=30
SESSION_SECRET=
INTERNAL_API_SECRET=
# Where the Discord bot exposes its internal role-sync API (PORT in the bot's .env).
BOT_INTERNAL_URL=http://127.0.0.1:3002

# Identifies the game server in SkyMP's master API contract. It MUST match
# "masterKey" in skymp/config/server-settings.*.json. Without it the endpoint
# /api/servers/:masterKey/sessions/:session always responds 404, and the
# server goes back to depending on the profileId the client reports.
MASTER_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/api/auth/discord/callback
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=skymp_rp

# false = no whitelist: anyone who signs in with Discord through the launcher plays,
# and the first login creates their character (they name it with /rpname).
# Must match in skymp/gamemode, apps/web and apps/game-api.
WHITELIST_REQUIRED=false
