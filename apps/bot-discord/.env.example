DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=
WHITELIST_ROLE_ID=
INTERNAL_API_SECRET=
PORT=3002
BOT_API_BIND_HOST=127.0.0.1

# Temporary voice channels (/voice-create, /voice-close) — a practical
# alternative while native in-game VOIP depends on a client patch that doesn't
# exist yet (see docs/technical/VOICE_CLIENT_PATCH.md).
STAFF_ROLE_ID=
VOICE_CATEGORY_ID=

# Moderation log (ARCHITECTURE.md 1.3). ID of the text channel that receives
# ban / kick / permakill / whitelist decisions.
#
# Leaving it empty TURNS OFF sending — the endpoint still responds 202 and
# nothing is posted. That is a valid operational choice: a server that doesn't
# want the channel must not see a `/permakill` fail because of it.
#
# The channel should be staff-only: the embeds carry kick reasons and whitelist
# review notes, which are text staff wrote about a player.
MODERATION_LOG_CHANNEL_ID=

# Discord roles that make someone staff in game and on the panel, as
# roleId:staffRole pairs (staffRole is moderator or admin; owner is set in the
# database only). Checked when a player signs in or presses Play.
# Example: STAFF_ROLE_MAP=111111111111111111:admin,222222222222222222:moderator
# Left empty, STAFF_ROLE_ID above grants moderator.
STAFF_ROLE_MAP=
